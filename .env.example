# GEMINI_API_KEY: Required for Gemini AI API calls on the backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Default verified Gemini model for Literature Studio.
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime variables (injected automatically in AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
