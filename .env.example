# LITERATURE STUDIO – VIETNAMESE EDITION
# CẤU HÌNH BIẾN MÔI TRƯỜNG (VITE + SUPABASE ANONYMOUS AUTH + VERCEL + GEMINI AI)
# ============================================================================

# 1. SUPABASE FRONTEND (Dùng cho Anonymous Sign-Ins & Row Level Security)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# 2. GOOGLE GEMINI AI (Chỉ cấu hình trên Backend / Vercel Environment Variables)
# TUYỆT ĐỐI KHÔNG đặt tiền tố VITE_ cho GEMINI_API_KEY để bảo mật khóa API!
GEMINI_API_KEY=your_gemini_api_key

# 3. URL ỨNG DỤNG
APP_URL=http://localhost:3000
